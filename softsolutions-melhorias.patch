+import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from "@/components/ui/accordion";
+import Reveal from "@/components/Reveal";
+
+const FAQS = [
+  {
+    q: "Quanto custa desenvolver um site ou sistema?",
+    a: "O valor depende do escopo, das funcionalidades e do prazo. Por isso, fazemos uma conversa inicial sem compromisso para entender sua necessidade e enviamos um orçamento detalhado e transparente.",
+  },
+  {
+    q: "Em quanto tempo meu projeto fica pronto?",
+    a: "Sites institucionais costumam ser entregues mais rápido do que sistemas e aplicativos sob medida. Após entender o escopo, apresentamos um cronograma com entregas em etapas para você acompanhar a evolução.",
+  },
+  {
+    q: "Vocês atendem empresas de outras cidades?",
+    a: "Sim. Somos de São Paulo e atendemos de forma remota em todo o Brasil, com reuniões por vídeo e acompanhamento online. Também é possível atendimento presencial na capital paulista.",
+  },
+  {
+    q: "Vocês oferecem suporte depois da entrega?",
+    a: "Sim. Acompanhamos o projeto após a publicação, corrigimos ajustes e podemos manter contrato de suporte e evolução contínua, conforme a sua necessidade.",
+  },
+  {
+    q: "O código e o projeto ficam sendo meus?",
+    a: "Combinamos tudo de forma clara em contrato, incluindo propriedade do projeto, acessos e documentação, para você ter segurança e independência.",
+  },
+  {
+    q: "Posso melhorar um sistema que já existe?",
+    a: "Podemos, sim. Analisamos o que você já tem, apontamos melhorias de desempenho, segurança e usabilidade, e evoluímos o sistema em vez de começar do zero quando isso faz sentido.",
+  },
+];
+
+const FAQ = () => (
+  <section id="faq" className="py-20 bg-gradient-to-b from-background to-secondary/10">
+    <div className="container mx-auto px-4 sm:px-6 lg:px-8 max-w-3xl">
+      <Reveal className="text-center mb-12">
+        <h2 className="text-3xl md:text-4xl lg:text-5xl font-bold text-foreground mb-4">Dúvidas Frequentes</h2>
+        <p className="text-xl text-muted-foreground">Respostas rápidas para as perguntas mais comuns</p>
+      </Reveal>
+
+      <Reveal>
+        <Accordion type="single" collapsible className="space-y-3">
+          {FAQS.map((item, index) => (
+            <AccordionItem
+              key={item.q}
+              value={`item-${index}`}
+              className="rounded-xl border border-border bg-card px-5 shadow-sm"
+            >
+              <AccordionTrigger className="text-left text-base md:text-lg font-semibold text-card-foreground hover:no-underline">
+                {item.q}
+              </AccordionTrigger>
+              <AccordionContent className="text-muted-foreground leading-relaxed">{item.a}</AccordionContent>
+            </AccordionItem>
+          ))}
+        </Accordion>
+      </Reveal>
+    </div>
+  </section>
+);
+
+export default FAQ;
