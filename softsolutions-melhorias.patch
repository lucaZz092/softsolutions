index 0000000..d3cf3b6
--- /dev/null
+++ b/src/components/Reveal.tsx
@@ -0,0 +1,54 @@
+import { useEffect, useRef, useState, type ReactNode } from "react";
+import { cn } from "@/lib/utils";
+
+interface RevealProps {
+  children: ReactNode;
+  className?: string;
+  /** atraso em ms, útil para escalonar cartões */
+  delay?: number;
+}
+
+/**
+ * Anima o conteúdo (fade + subida) quando ele entra na tela.
+ * Respeita `prefers-reduced-motion` e não esconde nada se IntersectionObserver não existir.
+ */
+const Reveal = ({ children, className, delay = 0 }: RevealProps) => {
+  const ref = useRef<HTMLDivElement>(null);
+  const [visible, setVisible] = useState(false);
+
+  useEffect(() => {
+    const el = ref.current;
+    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
+    if (!el || reduceMotion || !("IntersectionObserver" in window)) {
+      setVisible(true);
+      return;
+    }
+    const observer = new IntersectionObserver(
+      ([entry]) => {
+        if (entry.isIntersecting) {
+          setVisible(true);
+          observer.disconnect();
+        }
+      },
+      { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
+    );
+    observer.observe(el);
+    return () => observer.disconnect();
+  }, []);
+
+  return (
+    <div
+      ref={ref}
+      style={{ transitionDelay: visible ? `${delay}ms` : "0ms" }}
+      className={cn(
+        "transition-all duration-700 ease-out",
+        visible ? "opacity-100 translate-y-0" : "opacity-0 translate-y-6",
+        className
+      )}
+    >
+      {children}
+    </div>
+  );
+};
+
+export default Reveal;
